#!/usr/bin/expect -f
# Two vendors: the board opens on the Claude Code page with a tab bar, and tab
# switches to the Codex page. Enter and a there keep the board open and record
# nothing; run.sh asserts that neither vendor's .current was written.
set timeout 10
spawn sh -c "stty rows 24 columns 200; exec $env(HEADROOM_BIN) accounts"
expect {
    "tab switch" {}
    timeout { puts "the footer never offered tab — is Codex present in the fixture?"; exit 2 }
}
# The Claude Code page is the one that opens: its accounts, not Codex's.
expect {
    "a@x.com" {}
    timeout { puts "the board did not open on the Claude Code page"; exit 2 }
}
send -- "\t"
expect {
    "cx@x.com" {}
    timeout { puts "tab did not show the Codex page"; exit 2 }
}
send -- "\033\[B"
sleep 0.3
send -- "\r"
sleep 0.3
send -- "a"
sleep 0.3
expect {
    "q quit" {}
    timeout { puts "the board closed or stopped drawing after enter and a"; exit 2 }
}
send -- "q"
expect eof
catch wait result
if {[lindex $result 3] != 0} {
    puts "quit exited [lindex $result 3], want 0"
    exit 2
}
