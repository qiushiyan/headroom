#!/usr/bin/expect -f
# Watch draws its frame with the status footer, and q quits cleanly (exit 0)
# with the terminal restored by the session teardown.
set timeout 10
spawn $env(HEADROOM_BIN) watch --interval 30s
expect {
    "q quit" {}
    timeout { puts "watch never drew its footer"; exit 2 }
}
send -- "q"
expect eof
catch wait result
if {[lindex $result 3] != 0} {
    puts "watch exited [lindex $result 3], want 0"
    exit 2
}
