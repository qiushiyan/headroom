#!/usr/bin/expect -f
# A bare ESC closes the board: exit 0, nothing written (run.sh asserts the
# absence). The ESC resolves as a keypress only after the decoder's pause —
# this also exercises that path end to end.
set timeout 10
# A sizeless expect pty (0×0) makes headroom assume 80 columns and clip
# the footer these scripts match on; declare a real geometry like every
# real terminal does.
spawn sh -c "stty rows 24 columns 200; exec $env(HEADROOM_BIN) accounts"
expect {
    "q quit" {}
    timeout { puts "picker never drew its footer"; exit 2 }
}
send -- "\033"
expect eof
catch wait result
if {[lindex $result 3] != 0} {
    puts "esc exited [lindex $result 3], want 0"
    exit 2
}
