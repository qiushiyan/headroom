#!/usr/bin/expect -f
# SIGTERM mid-session: raw mode and the alternate screen are torn down in the
# same signal path; the sh wrapper survives headroom's death and records the
# pty's terminal state, which run.sh asserts is sane again.
set timeout 10
set cmd "sh -c 'echo \$\$ > \"$env(HEADROOM_PID_FILE)\"; exec \"$env(HEADROOM_BIN)\" sessions'; stty -a > $env(STTY_OUT) 2>&1"
spawn sh -c $cmd
expect {
    "q quit" {}
    timeout { puts "resume picker never drew its footer"; exit 2 }
}
sleep 0.2
set pidfile [open $env(HEADROOM_PID_FILE) r]
set child [string trim [read $pidfile]]
close $pidfile
if {![string is integer -strict $child] || $child <= 0} { puts "invalid fixture PID"; exit 2 }
exec kill -TERM $child
expect eof
