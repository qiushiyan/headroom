#!/usr/bin/expect -f
# The board records nothing. It marks the row a launch would take; enter and
# a, which once pinned the selected row and turned auto on, keep it open; q
# closes it with exit 0. run.sh asserts that .current was not written.
set timeout 10
# A sizeless expect pty (0×0) makes headroom assume 80 columns and clip
# the footer these scripts match on; declare a real geometry like every
# real terminal does.
spawn sh -c "stty rows 24 columns 200; exec $env(HEADROOM_BIN) accounts"
# The mark, on the one account of the fixture a launch could take.
expect {
    -re {a@x\.com[^\r\n]*← next} {}
    timeout { puts "the board under auto marks no account row"; exit 2 }
}
expect {
    "q quit" {}
    timeout { puts "picker never drew its footer"; exit 2 }
}
send -- "\033\[B"
sleep 0.3
send -- "\r"
sleep 0.3
send -- "a"
sleep 0.3
# Still open: the countdown is redrawn after both keys.
expect {
    "next refresh in" {}
    timeout { puts "the board closed or stopped drawing after enter and a"; exit 2 }
}
send -- "q"
expect eof
catch wait result
if {[lindex $result 3] != 0} {
    puts "quit exited [lindex $result 3], want 0"
    exit 2
}
