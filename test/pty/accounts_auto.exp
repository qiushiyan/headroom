#!/usr/bin/expect -f
# `a` turns automatic placement on: one confirmation line, exit 0. run.sh
# asserts that .current holds the word afterward. The second spawn opens the
# board under auto — the header says so — and enter pins the selected row
# again.
set timeout 10
# A sizeless expect pty (0×0) makes headroom assume 80 columns and clip
# the footer these scripts match on; declare a real geometry like every
# real terminal does.
spawn sh -c "stty rows 24 columns 200; exec $env(HEADROOM_BIN) accounts"
expect {
    "a auto" {}
    timeout { puts "the footer does not offer the auto key"; exit 2 }
}
send -- "a"
expect {
    "now choose the least-loaded account" {}
    timeout { puts "no confirmation line after a"; exit 2 }
}
expect eof
catch wait result
if {[lindex $result 3] != 0} {
    puts "a exited [lindex $result 3], want 0"
    exit 2
}

spawn sh -c "stty rows 24 columns 200; exec $env(HEADROOM_BIN) accounts"
expect {
    "bare launches are automatic" {}
    timeout { puts "the board under auto does not say the mode"; exit 2 }
}
expect {
    "esc cancel" {}
    timeout { puts "picker never drew its footer"; exit 2 }
}
send -- "\033"
expect eof
